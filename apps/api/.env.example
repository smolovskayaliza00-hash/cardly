# Порт HTTP-сервера
PORT=8787

# Токен бота от @BotFather — нужен для проверки подписи Telegram initData.
# НИКОГДА не коммитьте реальный токен.
BOT_TOKEN=

# Только для локальной разработки: пускать запросы без initData как демо-пользователя.
DEV_SKIP_AUTH=true

# Максимальный возраст initData, секунд
INIT_DATA_MAX_AGE_SEC=86400

# Разрешённый origin Mini App (через запятую). Пусто = любой (только для dev).
CORS_ORIGIN=

# Поставщики: mock — демо-реализация. Имя реального партнёра появится после интеграции.
CARD_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Параметры будущего партнёра (пример)
PARTNER_API_URL=
PARTNER_API_KEY=
PARTNER_WEBHOOK_SECRET=
